@page
@model DeveloprBud.Pages.EditCodeSnippetModel
@{
    ViewData["Title"] = "Edit Code Snippet";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">Edit Code Snippet</h1>
        <p class="text-muted">Update your saved snippet details</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <form method="post">

                        <input type="hidden" asp-for="SingleSnippet.Id" />

                        <div class="mb-3">
                            <label asp-for="SingleSnippet.Title" class="form-label"></label>
                            <input asp-for="SingleSnippet.Title" class="form-control" />
                            <span asp-validation-for="SingleSnippet.Title" class="text-danger"></span>
                        </div>

                        <!-- language loop -->
                        <div class="mb-3">
                            <label asp-for="SingleSnippet.Language" class="form-label"></label>

                            <select asp-for="SingleSnippet.Language" class="form-select">
                                <option value="">-- Select Language --</option>

                                @foreach (var lang in CodeLanguageHelper.CodeLanguages)
                                {
                                    <option value="@lang">@lang</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SingleSnippet.Code"></label>
                            <div id="editor" style="height:300px;border:1px solid #ddd;"></div>
                            <textarea asp-for="SingleSnippet.Code" id="codeField" hidden></textarea>
                        </div>

                        <div class="mb-4">
                            <label asp-for="SingleSnippet.Notes" class="form-label"></label>
                            <textarea asp-for="SingleSnippet.Notes"
                                      class="form-control"
                                      rows="5"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-page="/CodeSnippets" class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Message Implementation -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="liveToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Code Snippet Editor</strong>
                <small>@DateTime.Now.ToString("g")</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                @TempData["ToastMessage"]
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const toastElement =
                    document.getElementById('liveToast');

                const toast =
                    bootstrap.Toast.getOrCreateInstance(toastElement);

                toast.show();

            });
        </script>
    }

    <script>
        let editor;

        document.addEventListener("DOMContentLoaded", function () {

            editor = ace.edit("editor");

            editor.setTheme("ace/theme/chrome");
            editor.session.setMode("ace/mode/text");

            editor.setOptions({
                fontSize: "14px",
                showPrintMargin: false,
                wrap: true
            });

            // load existing code from hidden textarea
            const textarea = document.getElementById("codeField");
            editor.setValue(textarea.value || "", -1);

            // language change (fix selector if needed)
            const languageSelect = document.querySelector("[asp-for='SingleSnippet.Language']");

            if (languageSelect) {
                languageSelect.addEventListener("change", function () {
                    editor.session.setMode("ace/mode/" + this.value);
                });
            }

            // sync on submit
            document.querySelector("form").addEventListener("submit", function () {
                textarea.value = editor.getValue();
            });

        });
    </script>
}